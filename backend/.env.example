PORT=8080
HOST=0.0.0.0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_FILE=./data/app.sqlite
CORS_ORIGINS=https://your-app-domain.example
DEMO_MODE=false

# Independent staging must fail closed rather than silently falling back to SQLite.
REQUIRE_POSTGRES=true
PGSSLMODE=require
PG_POOL_MAX=10

# Set this only in the Render service environment; never commit credentials.
# DATABASE_URL=<Render internal PostgreSQL connection string>
